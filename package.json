{
  "name": "express-fileupload",
  "version": "1.6.0",
  "author": "Richard Girges <richardgirges@gmail.com>",
  "description": "Secure, developer-friendly Express file upload middleware and server example",
  "main": "./lib/index",
  "scripts": {
    "dev": "dotenv -e .env nodemon app/server.js",
    "start": "dotenv -e .env.production node app/server.js",
    "pm2:prod": "pm2 start ecosystem.config.js --only express-file-upload-9000",
    "pretest": "node ./test/pretests.js",
    "posttest": "node ./test/posttests.js",
    "test": "nyc  --reporter=html --reporter=text mocha -- -R spec",
    "test:unit": "npm run pretest && mocha -- -R spec && npm run posttest",
    "lint": "eslint ./",
    "check": "npm run lint && npm test",
    "lint:fix": "eslint --fix ./"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "keywords": [
    "express",
    "file-upload",
    "upload",
    "forms",
    "multipart",
    "files",
    "busboy",
    "middleware"
  ],
  "license": "MIT",
  "repository": "https://github.com/erolsenol/nodejs-file-server",
  "bugs": {
    "url": "https://github.com/erolsenol/nodejs-file-server/issues"
  },
  "homepage": "https://github.com/erolsenol/nodejs-file-server#readme",
  "devDependencies": {
    "eslint": "^7.31.0",
    "express": "^4.18.1",
    "md5": "^2.3.0",
    "mocha": "^10.0.0",
    "nodemon": "^3.1.0",
    "nyc": "^15.1.0",
    "rimraf": "^3.0.2",
    "rnd-file": "^0.0.1",
    "supertest": "^6.1.5"
  }
}
