{
  "name": "@erolsenol/nodejs-file-server",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r build",
    "changeset": "changeset",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "dev": "pnpm --filter @file-server/app dev",
    "format": "prettier --write .",
    "lint": "eslint .",
    "start": "pnpm --filter @file-server/app start",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript-eslint": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  }
}
